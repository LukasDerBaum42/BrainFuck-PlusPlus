@(sub)
@(add)
@(mul)

§(temp)
§(math)

// does nothing
!(){}

// prints a newline
!(nl){
    :(temp)
    >3
    +10 .
    [-]
    <3
    :(math)
}

// prints " E "
!(sp){
    :(temp)
    >3
    +32 .
    [-]
    +69 .
    [-]
    +32 .
    [-]
    <3
    :(math)
}


!(go_to_start){
    >
    ${
        *0(go_to_start)
    }
}

// checks if the next 8 bytes are zero
// if they are not, sets the all_zero flag to 0
// else, sets the all_zero flag to the amount of none zero bytes
!(all_zero){
    :(temp)
    [-]
    :(math)
    $(all_zero_set){
        *0()
    }
    >
    $(all_zero_set){
        *0()
    }
    >
    $(all_zero_set){
        *0()
    }
    >
    $(all_zero_set){
        *0()
    }
    >
    $(all_zero_set){
        *0()
    }
    >
    $(all_zero_set){
        *0()
    }
    >
    $(all_zero_set){
        *0()
    }
    >
    $(all_zero_set){
        *0()
    }
    <7
}

!(all_zero_set){
    :(temp) + :(math)
}