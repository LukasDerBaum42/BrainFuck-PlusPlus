

!(add_carry){
    + >
    $(add_one){
       *255(add_carry)
    } 
    <
}

!(add_one){
    +
}


!(add)(^8 : i64 , ^8 : i64)(^8){
    :(math)
    // load the two numbers into the math section
    + > v >9 [-] - > v
    // checks if the right number is zero
    :(math)
    ?(all_zero)
    :(temp)
    > [-] <
    [
        // finds the currnt byte
        > [- :(math)>:(temp)] <
        
        // add one byte
        :(math)
        [
            - <10
            $(add_one){
                *255(add_carry)
            }
            >10
        ]

        // returns to the start and chechs if all bytes are zero
        +[- <+ :(temp)>+<:(math) ]->
        :(math)
        ?(all_zero)
        :(temp)
    ]
    :(math)
    <20
    ?(go_to_start)
    [-] > ^^8 < :
}